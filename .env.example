# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# APP_ENV: Environment mode switch ('development' | 'production').
APP_ENV=production

# Razorpay Online Payment Gateway Integration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email Dispatch (Strictly sent from evitron26@gmail.com with Attendee QR Code)
SMTP_USER=evitron26@gmail.com
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Google Sheets Real-Time Sync Webhook URL (Optional)
GOOGLE_SHEET_WEBHOOK_URL=
